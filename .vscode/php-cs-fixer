#!/usr/bin/env bash
# Bridge for junstyle.php-cs-fixer: host has no PHP; run Fixer inside the workspace container.
# Temp files from the extension live under /tmp on the host — copy into the mounted tree, fix, copy back.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST_WORKSPACE="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONTAINER="boilerplate-laravel-workspace"
CONTAINER_WORKSPACE="/var/www"

args=()
TEMP_HOST=""
filename=""

for arg in "$@"; do
  if [[ "$arg" == --config=* ]]; then
    config="${arg#--config=}"
    config="${config//$HOST_WORKSPACE/$CONTAINER_WORKSPACE}"
    args+=("--config=$config")
    continue
  fi

  if [[ "$arg" == /tmp/pcf-tmp* ]]; then
    TEMP_HOST="$arg"
    filename="${arg##*/}"
    mkdir -p "${HOST_WORKSPACE}/.vscode/php-cs-fixer-tmp"
    cp "$TEMP_HOST" "${HOST_WORKSPACE}/.vscode/php-cs-fixer-tmp/${filename}"
    args+=("${CONTAINER_WORKSPACE}/.vscode/php-cs-fixer-tmp/${filename}")
    continue
  fi

  args+=("$arg")
done

docker container exec -i \
  "$CONTAINER" \
  /var/www/vendor/bin/php-cs-fixer \
  "${args[@]}"

if [[ -n "$TEMP_HOST" ]]; then
  cp \
    "${HOST_WORKSPACE}/.vscode/php-cs-fixer-tmp/${filename}" \
    "$TEMP_HOST"
fi
