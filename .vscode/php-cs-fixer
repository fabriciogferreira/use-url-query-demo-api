#!/usr/bin/env bash
# Bridge for junstyle.php-cs-fixer: host has no PHP; run Fixer inside the workspace container.
# Extension temps live under /tmp on the host. Do not rely on the project bind-mount alone
# (host-card / shared mounts may not expose /tmp). Always docker cp the temp (and config),
# fix, copy back.

set -euo pipefail

# On clone/fork: rename to match compose.dev.yaml workspace container_name
# (see README "Docker container names"). Stale name → docker exec ENOENT.
CONTAINER="use-url-query-demo-api-workspace"
CONTAINER_TMP="/tmp/pcf-bridge-$$"

if ! docker container inspect "$CONTAINER" >/dev/null 2>&1; then
  # Host-card compose omits fixed container_name; pick a running *workspace* for this project.
  alt=$(docker ps --format '{{.Names}}' | grep -E 'use-url-query.*workspace' | head -n1 || true)
  if [[ -n "$alt" ]]; then
    CONTAINER="$alt"
  else
    echo "php-cs-fixer: no container '${CONTAINER}' (and no host-card *workspace)." >&2
    exit 1
  fi
fi

args=()
TEMP_HOST=""
filename=""
HOST_CONFIG=""

cleanup() {
  docker container exec "$CONTAINER" rm -rf "$CONTAINER_TMP" >/dev/null 2>&1 || true
}
trap cleanup EXIT

for arg in "$@"; do
  if [[ "$arg" == --config=* ]]; then
    HOST_CONFIG="${arg#--config=}"
    continue
  fi

  if [[ "$arg" == /tmp/pcf-tmp* ]]; then
    TEMP_HOST="$arg"
    filename="${arg##*/}"
    continue
  fi

  args+=("$arg")
done

docker container exec "$CONTAINER" mkdir -p "$CONTAINER_TMP"

if [[ -n "$HOST_CONFIG" ]]; then
  docker cp "$HOST_CONFIG" "${CONTAINER}:${CONTAINER_TMP}/.php-cs-fixer.php"
  args+=("--config=${CONTAINER_TMP}/.php-cs-fixer.php")
fi

if [[ -n "$TEMP_HOST" ]]; then
  docker cp "$TEMP_HOST" "${CONTAINER}:${CONTAINER_TMP}/${filename}"
  args+=("${CONTAINER_TMP}/${filename}")
fi

docker container exec -i \
  "$CONTAINER" \
  /var/www/vendor/bin/php-cs-fixer \
  "${args[@]}"

if [[ -n "$TEMP_HOST" ]]; then
  docker cp "${CONTAINER}:${CONTAINER_TMP}/${filename}" "$TEMP_HOST"
fi
