includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    tmpDir: tmp

    paths:
        - app/
        - bootstrap/
        - config/
        - database/
        # - lang/
        - routes/
        - tests/
        - database/
    # Level 10 is the highest level
    level: 10

    ignoreErrors:
        # Trait is required by Enum architecture; unused until the first domain enum exists.
        -
            identifier: trait.unused
            path: app/Traits/Enumerable.php

#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
